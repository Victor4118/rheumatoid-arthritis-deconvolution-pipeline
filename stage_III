cat("\n[+] Calculating orthogonality\n")

matriz_ancha <- function(metodo, granularidad) {
  larga <- todos_resultados %>%
    filter(Method == metodo, Granularidad == granularidad, Linaje_Global != "Other") %>%
    select(Sample, CellType, Score) %>%
    pivot_wider(names_from = CellType, values_from = Score)
    
  matriz <- as.matrix(larga[, -1, drop = FALSE])
  rownames(matriz) <- larga$Sample
  return(matriz)
}

correlacion_cruzada <- function(granularidad) {
  epic <- matriz_ancha("EPIC", granularidad)
  cbx  <- matriz_ancha("CIBERSORTx", granularidad)
  
  if (!nrow(cbx)) return(NULL)
  
  muestras <- intersect(rownames(epic), rownames(cbx))
  tipos    <- intersect(colnames(epic), colnames(cbx))
  
  suppressWarnings(cor(epic[muestras, tipos], cbx[muestras, tipos], method = "spearman"))
}

cruzadas <- Filter(Negate(is.null), lapply(c(CLASS = "CLASS", SUBCLASS = "SUBCLASS"), correlacion_cruzada))

if (length(cruzadas)) {
  cruzada_larga <- bind_rows(lapply(names(cruzadas), function(g) {
    as.data.frame(cruzadas[[g]]) %>% 
      rownames_to_column("EPIC") %>%
      pivot_longer(-EPIC, names_to = "CIBERSORTx", values_to = "rho") %>%
      mutate(
        Granularidad = g, 
        Linaje_EPIC  = linaje_de(EPIC),
        Linaje_CBX   = linaje_de(CIBERSORTx), 
        diagonal     = EPIC == CIBERSORTx
      )
  }))
  
  write_csv(cruzada_larga, file.path(tablas, "T_ortogonalidad_metodos.csv"))
  
  ortogonalidad <- cruzada_larga %>%
    filter(Granularidad == "CLASS" | Linaje_EPIC == Linaje_CBX) %>%
    group_by(Granularidad, Linaje_EPIC, EPIC) %>%
    summarise(
      rho_diagonal      = rho[diagonal][1],
      rho_maximo_vecino = suppressWarnings(max(rho[!diagonal], na.rm = TRUE)),
      vecino            = CIBERSORTx[!diagonal][which.max(rho[!diagonal])][1],
      .groups           = "drop"
    ) %>%
    mutate(
      rho_maximo_vecino = ifelse(is.finite(rho_maximo_vecino), rho_maximo_vecino, NA_real_),
      margen            = round(rho_diagonal - rho_maximo_vecino, 3),
      resuelta          = !is.na(margen) & margen > 0,
      across(c(rho_diagonal, rho_maximo_vecino), ~ round(.x, 3))
    ) %>%
    arrange(Granularidad, desc(margen))
    
  print(as.data.frame(ortogonalidad), row.names = FALSE)
  write_csv(ortogonalidad, file.path(tablas, "T_margen_ortogonalidad.csv"))
  
  pie_ortogonalidad <- paste(
    "Cada celda es la correlacion entre la estimacion de un metodo para una",
    "poblacion y la del otro metodo para otra poblacion del mismo linaje.",
    "El recuadro\nnegro senala la diagonal. Una firma que resuelve sus",
    "subpoblaciones produce una matriz diagonal. Al tratarse de fracciones que",
    "suman la unidad, parte\nde la correlacion negativa fuera de la diagonal",
    "procede de la restriccion composicional y no de una confusion entre poblaciones."
  )
  
  heatmap_cruzado <- function(seleccion, titulo, subtitulo) {
    ggplot(seleccion, aes(CIBERSORTx, EPIC)) +
      geom_tile(aes(fill = rho), colour = "white", linewidth = 1) +
      geom_tile(data = filter(seleccion, diagonal), fill = NA, colour = "black", linewidth = 0.9) +
      geom_text(aes(label = ifelse(is.na(rho), "", sprintf("%.2f", rho))), size = 3) +
      scale_fill_gradient2(
        limits = c(-1, 1), low = "#0072B2", mid = "grey97",
        high = "#D55E00", na.value = "grey90", name = "Rho de Spearman"
      ) +
      coord_fixed() + 
      tema +
      theme(panel.grid = element_blank(), axis.text.x = element_text(angle = 45, hjust = 1)) +
      labs(title = titulo, subtitle = subtitulo, x = "CIBERSORTx", y = "EPIC", caption = pie_ortogonalidad)
  }
  
  guardar(
    heatmap_cruzado(
      filter(cruzada_larga, Granularidad == "CLASS"),
      "Ortogonalidad entre CIBERSORTx y EPIC en los Linajes Sinoviales",
      "Correlacion cruzada de todas las estimaciones frente a todas"
    ),
    "G06_Ortogonalidad_CLASS.jpg", 8, 7
  )
  
  paneles <- list()
  for (linaje in names(LINAJES)) {
    seleccion <- filter(cruzada_larga, Granularidad == "SUBCLASS", Linaje_EPIC == linaje, Linaje_CBX == linaje)
    if (!nrow(seleccion)) next
    
    lado <- 3.5 + 0.7 * length(unique(seleccion$EPIC))
    figura <- heatmap_cruzado(
      seleccion,
      paste0("Ortogonalidad entre Metodos: ", LINAJES[[linaje]]),
      "Correlacion cruzada entre las subpoblaciones de un mismo linaje"
    )
    
    guardar(figura, paste0("G07_Ortogonalidad_", linaje, ".jpg"), lado, lado)
    
    paneles[[linaje]] <- figura +
      labs(title = LINAJES[[linaje]], subtitle = NULL, caption = NULL) +
      theme(legend.position = "none")
  }
  
  if (length(paneles) > 1) {
    guardar(
      wrap_plots(paneles, ncol = 2) +
        plot_annotation(
          title    = "Ortogonalidad entre CIBERSORTx y EPIC por Linaje",
          subtitle = "Correlacion cruzada dentro de cada linaje; el recuadro negro marca la diagonal",
          caption  = pie_ortogonalidad, 
          theme    = tema
        ),
      "G08_Ortogonalidad_Panel_Linajes.jpg", 13, 12
    )
  }
}

