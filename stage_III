leer_cibersortx <- function(granularidad) {
  archivo <- file.path("data", paste0("CIBERSORTx_Results_STRAP_", granularidad, ".csv"))
  if (!file.exists(archivo)) {
    message("Falta ", archivo)
    return(tibble())
  }
  
  bruto <- read.csv(archivo, check.names = FALSE)
  names(bruto)[1] <- "Sample"
  
  if ("P-value" %in% names(bruto)) {
    cat(sprintf("    %s: %d de %d muestras con p > 0,05\n", granularidad, sum(bruto$`P-value` > 0.05, na.rm = TRUE), nrow(bruto)))
  }
  
  bruto %>%
    select(-any_of(c("P-value", "Correlation", "RMSE", "Absolute score (sig.score)"))) %>%
    pivot_longer(-Sample, names_to = "CellType", values_to = "Score") %>%
    mutate(
      CellType     = canonizar(CellType), 
      Method       = "CIBERSORTx",
      Granularidad = granularidad
    )
}

