cat("\n[+] Auditing signatures\n")

leer_firma <- function(granularidad) {
  bruto <- read.delim(file.path(entrada, paste0("Signature_Matrix_", granularidad, ".txt")), check.names = FALSE)
  matriz <- as.matrix(bruto[, -1, drop = FALSE])
  rownames(matriz) <- bruto$GeneSymbol
  matriz[is.na(matriz)] <- 0
  return(matriz)
}

firmas <- list(CLASS = leer_firma("CLASS"), SUBCLASS = leer_firma("SUBCLASS"))

auditar <- function(matriz, granularidad) {
  correlaciones <- cor(matriz, method = "spearman")
  diag(correlaciones) <- NA
  pares <- which(abs(correlaciones) > 0.7, arr.ind = TRUE)
  pares <- pares[pares[, 1] < pares[, 2], , drop = FALSE]
  
  resumen_tbl <- tibble(
    Granularidad             = granularidad, 
    Genes                    = nrow(matriz), 
    Tipos                    = ncol(matriz),
    Kappa                    = round(kappa(matriz, exact = TRUE), 1),
    Valor_maximo             = round(max(matriz), 1),
    Cobertura_STRAP_pct      = round(100 * mean(rownames(matriz) %in% rownames(mezcla)), 1),
    Tipos_menos_5_marcadores = sum(colSums(matriz != 0) < 5),
    Pares_colineales         = nrow(pares)
  )
  
  colineales_tbl <- if (nrow(pares) == 0) tibble() else {
    tibble(
      Granularidad = granularidad,
      tipo_A       = rownames(correlaciones)[pares[, 1]],
      tipo_B       = colnames(correlaciones)[pares[, 2]],
      rho          = round(correlaciones[pares], 2)
    ) %>% arrange(desc(abs(rho)))
  }
  
  list(resumen = resumen_tbl, colineales = colineales_tbl)
}

auditorias <- lapply(names(firmas), function(g) auditar(firmas[[g]], g))
auditoria  <- bind_rows(lapply(auditorias, `[[`, "resumen"))
colineales <- bind_rows(lapply(auditorias, `[[`, "colineales"))

