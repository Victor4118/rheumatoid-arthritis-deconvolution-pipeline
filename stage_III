convergencia <- list()

epic_propio <- function(matriz, granularidad) {
  comunes <- intersect(rownames(matriz), rownames(mezcla))
  ajuste  <- EPIC(
    bulk           = mezcla[comunes, , drop = FALSE],
    reference      = list(refProfiles = matriz[comunes, , drop = FALSE], sigGenes = comunes),
    withOtherCells = TRUE
  )
  
  convergencia[[granularidad]] <<- tibble(
    Sample       = rownames(ajuste$cellFractions), 
    Granularidad = granularidad,
    codigo       = ajuste$fit.gof$convergeCode,
    convergio    = ajuste$fit.gof$convergeCode == 0
  )
  
  ajuste$cellFractions %>% 
    as.data.frame() %>% 
    rownames_to_column("Sample") %>%
    pivot_longer(-Sample, names_to = "CellType", values_to = "Score") %>%
    mutate(
      CellType     = canonizar(CellType), 
      Method       = "EPIC",
      Granularidad = granularidad
    )
}

