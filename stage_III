cat("\n[+] External validation\n")

if (!file.exists(RUTA_METADATOS)) {
  message("Validacion externa omitida: falta ", RUTA_METADATOS)
} else {
  bruto <- read.delim(RUTA_METADATOS, check.names = FALSE, stringsAsFactors = FALSE)
  
  columna <- function(nombre, numerica = FALSE) {
    posicion <- which(names(bruto) == nombre)[1]
    if (is.na(posicion)) {
      warning("Columna ausente en los metadatos: ", nombre)
      return(rep(NA, nrow(bruto)))
    }
    valores <- bruto[[posicion]]
    if (numerica) suppressWarnings(as.numeric(valores)) else as.character(valores)
  }
  
  metadatos <- tibble(
    Sample          = columna("Characteristics[sampleid]"),
    Paciente        = columna("Characteristics[individual]"),
    Patotipo        = columna("Characteristics[pathotype]"),
    Compartimento_B = columna("Characteristics[cell.type (bcell)]"),
    Edad            = columna("Characteristics[age]", TRUE),
    Sexo            = columna("Characteristics[sex]"),
    FR              = columna("Characteristics[rf_status]"),
    ACPA            = columna("Characteristics[ccp_status]"),
    TJC             = columna("Characteristics[tender_joints_counts_tjc]", TRUE),
    SJC             = columna("Characteristics[swollen_joints_counts_sjc]", TRUE),
    VSG             = columna("Characteristics[esr]", TRUE),
    PCR             = columna("Characteristics[crp]", TRUE),
    ACR20           = columna("Characteristics[acr20_response]")
  ) %>%
    distinct(Sample, .keep_all = TRUE) %>%
    mutate(
      Patotipo = recode(Patotipo, Fibrous = "Fibroid"),
      Patotipo = na_if(Patotipo, "Ungraded"),
      across(c(Patotipo, Compartimento_B, Sexo, FR, ACPA), ~ na_if(.x, "NA"))
    )
  
  print(table(metadatos$Patotipo, metadatos$Compartimento_B, useNA = "ifany"))
  print(table(metadatos$ACR20, useNA = "ifany"))
  write_csv(metadatos, file.path(tablas, "T_metadatos_clinicos.csv"))
  
  validacion <- todos_resultados %>%
    filter(Method %in% c("EPIC", "CIBERSORTx"), Linaje_Global != "Other") %>%
    inner_join(metadatos, by = "Sample")
    
  cat(sprintf("    Muestras emparejadas: %d\n", n_distinct(validacion$Sample)))
  if (!n_distinct(validacion$Sample)) stop("Sin correspondencia de identificadores.")
  
  compartimento_b <- validacion %>%
    filter(!is.na(Compartimento_B)) %>%
    group_by(Granularidad, Method, Linaje_Global, CellType) %>%
    filter(n_distinct(Compartimento_B) == 2, sd(Score) > 0) %>%
    summarise(
      n             = n(),
      mediana_Brich = round(median(Score[Compartimento_B == "Brich"]), 4),
      mediana_Bpoor = round(median(Score[Compartimento_B == "Bpoor"]), 4),
      p             = wilcox.test(Score ~ factor(Compartimento_B))$p.value,
      AUC           = round(as.numeric(auc(roc(
                        factor(Compartimento_B), Score, quiet = TRUE,
                        levels = c("Bpoor", "Brich"), direction = "<"))), 3),
      .groups       = "drop"
    ) %>%
    group_by(Granularidad, Method) %>%
    mutate(p_ajustada = p.adjust(p, method = "BH")) %>% 
    ungroup() %>%
    arrange(desc(AUC))
    
  print(as.data.frame(compartimento_b), row.names = FALSE)
  write_csv(compartimento_b, file.path(tablas, "T_validacion_compartimento_B.csv"))
  
  esperado <- c(B_cell = "Lymphoid", T_cell = "Lymphoid", Monocyte = "Myeloid", Fibroblast = "Fibroid")
  
  patotipo <- validacion %>%
    filter(!is.na(Patotipo)) %>%
    group_by(Granularidad, Method, Linaje_Global, CellType) %>%
    filter(n_distinct(Patotipo) == 3, sd(Score) > 0) %>%
    summarise(
      n                = n(), 
      p                = kruskal.test(Score ~ factor(Patotipo))$p.value,
      mediana_Lymphoid = round(median(Score[Patotipo == "Lymphoid"]), 4),
      mediana_Myeloid  = round(median(Score[Patotipo == "Myeloid"]), 4),
      mediana_Fibroid  = round(median(Score[Patotipo == "Fibroid"]), 4),
      .groups          = "drop"
    ) %>%
    mutate(
      patotipo_dominante = case_when(
        mediana_Lymphoid >= mediana_Myeloid & mediana_Lymphoid >= mediana_Fibroid ~ "Lymphoid",
        mediana_Myeloid >= mediana_Fibroid ~ "Myeloid", 
        TRUE ~ "Fibroid"
      ),
      patotipo_esperado = unname(esperado[Linaje_Global]),
      correcto          = patotipo_dominante == patotipo_esperado
    ) %>%
    group_by(Granularidad, Method) %>%
    mutate(p_ajustada = p.adjust(p, method = "BH")) %>% 
    ungroup() %>%
    arrange(p_ajustada)
    
  print(as.data.frame(patotipo), row.names = FALSE)
  write_csv(patotipo, file.path(tablas, "T_validacion_patotipo.csv"))
  cat(sprintf("    Maximo en el patotipo esperado: %d de %d\n", sum(patotipo$correcto), nrow(patotipo)))
  
  p_val_b <- validacion %>%
    filter(!is.na(Compartimento_B), Granularidad == "CLASS") %>%
    mutate(Linaje = factor(LINAJES[Linaje_Global], levels = LINAJES)) %>%
    ggplot(aes(Compartimento_B, Score, fill = Compartimento_B)) +
    geom_boxplot(outlier.size = 0.6, linewidth = 0.3, alpha = 0.85) +
    facet_grid(Method ~ Linaje, scales = "free_y") +
    scale_fill_manual(values = PALETA_B, name = NULL) + 
    tema +
    labs(
      title    = "Fracciones Estimadas segun la Estratificacion Histologica en Linfocitos B",
      subtitle = "Clasificacion asignada por el patologo sobre la biopsia basal",
      x        = NULL, 
      y        = "Fraccion Estimada",
      caption  = paste("La clasificacion en B-cell rich y B-cell poor procede de la lectura",
                       "histologica y es independiente de la deconvolucion.\nSe espera que",
                       "el compartimento B separe ambos grupos y que los demas linajes no lo hagan.")
    )
  guardar(p_val_b, "G09_Validacion_Compartimento_B.jpg", 10, 6)
  
  p_val_p <- validacion %>%
    filter(!is.na(Patotipo), Granularidad == "CLASS") %>%
    mutate(
      Linaje   = factor(LINAJES[Linaje_Global], levels = LINAJES),
      Patotipo = factor(Patotipo, levels = names(PALETA_PATOTIPO))
    ) %>%
    ggplot(aes(Patotipo, Score, fill = Patotipo)) +
    geom_boxplot(outlier.size = 0.6, linewidth = 0.3, alpha = 0.85) +
    facet_grid(Method ~ Linaje, scales = "free_y") +
    scale_fill_manual(values = PALETA_PATOTIPO, name = NULL) + 
    tema +
    theme(axis.text.x = element_blank(), axis.ticks.x = element_blank()) +
    labs(
      title    = "Fracciones Estimadas segun el Patotipo Sinovial Histologico",
      subtitle = "Patotipo asignado por el patologo sobre la biopsia basal",
      x        = NULL, 
      y        = "Fraccion Estimada",
      caption  = paste("Se espera que cada linaje alcance su valor maximo en el patotipo",
                       "que lleva su nombre: linfoide para los linfocitos,\nmieloide para",
                       "los macrofagos y fibroide para los fibroblastos.")
    )
  guardar(p_val_p, "G10_Validacion_Patotipo.jpg", 10, 6)
  
  p_val_sub <- validacion %>%
    filter(!is.na(Patotipo), Granularidad == "SUBCLASS", Method == "CIBERSORTx") %>%
    semi_join(filter(fiables, fiable), by = c("Granularidad", "CellType")) %>%
    mutate(Patotipo = factor(Patotipo, levels = names(PALETA_PATOTIPO))) %>%
    ggplot(aes(Patotipo, Score, fill = Patotipo)) +
    geom_boxplot(outlier.size = 0.5, linewidth = 0.25, alpha = 0.85) +
    facet_wrap(~ CellType, scales = "free_y", ncol = 4) +
    scale_fill_manual(values = PALETA_PATOTIPO, name = NULL) + 
    tema +
    theme(axis.text.x = element_blank(), axis.ticks.x = element_blank()) +
    labs(
      title    = "Subpoblaciones Fiables segun el Patotipo Sinovial",
      subtitle = "Estimaciones de CIBERSORTx en las poblaciones que superaron el criterio de concordancia",
      x        = NULL, 
      y        = "Fraccion Estimada",
      caption  = "Solo se representan las subpoblaciones cuya estimacion concordo entre ambos algoritmos."
    )
  guardar(p_val_sub, "G11_Validacion_Patotipo_Subclases.jpg", 11, 7)
}

