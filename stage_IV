pliegues_estratificados <- function(y, k) {
  indice <- integer(length(y))
  for (nivel in levels(y)) {
    pos <- which(y == nivel)
    indice[sample(pos)] <- rep_len(seq_len(k), length(pos))
  }
  indice
}

ajustar_podado <- function(formula, entrenamiento) {
  fit <- rpart(formula, data = entrenamiento, method = "class",
               control = rpart.control(cp = 0, minbucket = 5, xval = 10))
  tab <- fit$cptable
  objetivo <- min(tab[, "xerror"]) + tab[which.min(tab[, "xerror"]), "xstd"]
  cp_opt <- tab[which(tab[, "xerror"] <= objetivo)[1], "CP"]
  prune(fit, cp = cp_opt)
}

metricas <- function(observado, predicho, niveles) {
  observado <- factor(observado, levels = niveles)
  predicho  <- factor(predicho,  levels = niveles)
  tb <- table(observado, predicho)
  n <- sum(tb)
  exactitud <- sum(diag(tb)) / n
  recall <- diag(tb) / pmax(rowSums(tb), 1)
  esperado <- sum(rowSums(tb) * colSums(tb)) / n^2
  list(exactitud = exactitud,
       equilibrada = mean(recall),
       kappa = (exactitud - esperado) / (1 - esperado),
       recall = recall, tabla = tb)
}

validar <- function(predictoras, etiqueta) {
  predictoras_escapadas <- paste0("`", predictoras, "`")
  formula <- as.formula(paste("Patotipo ~", paste(predictoras_escapadas, collapse = " + ")))
  niveles <- levels(datos$Patotipo)
  acumulado <- matrix(0, length(niveles), length(niveles),
                      dimnames = list(niveles, niveles))
  filas <- vector("list", N_REPETICIONES)
  
  for (r in seq_len(N_REPETICIONES)) {
    indice <- pliegues_estratificados(datos$Patotipo, N_PLIEGUES)
    predicho <- factor(rep(NA, nrow(datos)), levels = niveles)
    for (k in seq_len(N_PLIEGUES)) {
      fit <- ajustar_podado(formula, datos[indice != k, ])
      predicho[indice == k] <- predict(fit, datos[indice == k, ], type = "class")
    }
    m <- metricas(datos$Patotipo, predicho, niveles)
    acumulado <- acumulado + m$tabla
    filas[[r]] <- c(exactitud = m$exactitud, equilibrada = m$equilibrada,
                    kappa = m$kappa, m$recall)
  }
  
  M <- do.call(rbind, filas)
  nir <- max(table(datos$Patotipo)) / nrow(datos)
  resumen <- tibble(Modelo = etiqueta,
                    n = nrow(datos),
                    predictoras = length(predictoras),
                    exactitud = round(mean(M[, "exactitud"]), 3),
                    ic_inf = round(unname(quantile(M[, "exactitud"], .025)), 3),
                    ic_sup = round(unname(quantile(M[, "exactitud"], .975)), 3),
                    equilibrada = round(mean(M[, "equilibrada"]), 3),
                    kappa = round(mean(M[, "kappa"]), 3),
                    tasa_sin_informacion = round(nir, 3),
                    p_binomial = signif(binom.test(
                      round(mean(M[, "exactitud"]) * nrow(datos)),
                      nrow(datos), nir, alternative = "greater")$p.value, 3))
  recalls <- as_tibble(t(round(colMeans(M[, niveles, drop = FALSE]), 3))) %>%
    mutate(Modelo = etiqueta, .before = 1)
  
  list(resumen = resumen, recall = recalls,
       confusion = round(acumulado / N_REPETICIONES, 1))
}

