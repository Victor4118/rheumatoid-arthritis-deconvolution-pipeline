# Continuous variables are summarised by median and interquartile range because
# none of the activity indices is symmetric. Epsilon squared and Cramer's V are
# reported so that the reader sees magnitude and not only a p value.

resumen_continua <- function(x, g) {
  ok <- !is.na(x) & !is.na(g)
  x <- x[ok]; g <- droplevels(g[ok])
  por_grupo <- tapply(x, g, function(v)
    sprintf("%.1f [%.1f-%.1f]", median(v), quantile(v, .25), quantile(v, .75)))
  pr <- kruskal.test(x, g)
  k <- nlevels(g); n <- length(x)
  tibble(Global = sprintf("%.1f [%.1f-%.1f]", median(x),
                          quantile(x, .25), quantile(x, .75)),
         !!!as.list(por_grupo),
         n_valido = n,
         Efecto = sprintf("eps2 = %.3f",
                          (unname(pr$statistic) - k + 1) / (n - k)),
         p = signif(pr$p.value, 3))
}

resumen_categorica <- function(x, g) {
  ok <- !is.na(x) & !is.na(g)
  x <- droplevels(factor(x[ok])); g <- droplevels(g[ok])
  tb <- table(x, g)
  ref <- levels(x)[nlevels(x)]
  pct <- function(v) sprintf("%d (%.1f %%)", sum(v == ref),
                             100 * mean(v == ref))
  por_grupo <- tapply(x, g, pct)
  pr <- fisher.test(tb, simulate.p.value = TRUE, B = 10000)
  v <- sqrt(unname(suppressWarnings(chisq.test(tb)$statistic)) /
              (length(x) * (min(dim(tb)) - 1)))
  tibble(Global = pct(x), !!!as.list(por_grupo), n_valido = length(x),
         Efecto = sprintf("V = %.3f", v), p = signif(pr$p.value, 3))
}

