reemplazar_ceros <- function(M) {
  limite <- apply(M, 2, function(x) {
    p <- x[x > 0]
    if (length(p) == 0) stop("Poblacion nula en toda la cohorte.")
    0.65 * min(p)
  })
  M <- M / rowSums(M)
  for (i in seq_len(nrow(M))) {
    cero <- M[i, ] == 0
    if (!any(cero)) next
    masa <- sum(limite[cero])
    if (masa >= 1) stop("La masa imputada agota la composicion.")
    M[i, cero] <- limite[cero]
    M[i, !cero] <- M[i, !cero] * (1 - masa)
  }
  M
}

# The reference of the transform is the analysable subcomposition, so every
# coordinate is read relative to the populations that survived Stage III.
construir_clr <- function(metodo, granularidad) {
  poblaciones <- sel(granularidad)
  sub <- resultados %>%
    filter(Method == metodo, Granularidad == granularidad,
           CellType %in% poblaciones)
  if (nrow(sub) == 0) return(NULL)
  ancha <- sub %>% select(Sample, CellType, Score) %>%
    pivot_wider(names_from = CellType, values_from = Score)
  if (any(is.na(ancha))) stop("Valores ausentes tras el pivotado.")
  M <- as.matrix(ancha[, -1, drop = FALSE]); rownames(M) <- ancha$Sample
  if (any(M < 0)) stop("Estimaciones negativas en la composicion.")
  L <- log(reemplazar_ceros(M))
  as.data.frame(L - rowMeans(L)) %>%
    rownames_to_column("Sample") %>%
    mutate(Paciente = sub("[-_.][^-_.]+$", "", Sample), .before = 1)
}

